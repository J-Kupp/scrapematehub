# Supplier tokens
YBM_TOKEN_SWISSBOX=replace_with_real_token

# Control panel auth
CONTROL_PANEL_SESSION_SECRET=replace_with_a_long_random_secret
CONTROL_PANEL_ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Optional shared secrets loading
SHARED_SECRETS_BACKEND=
AWS_SECRETS_MANAGER_SECRET_ID=
AWS_REGION=

# Writable runtime roots
SUPPLIER_OUTPUT_ROOT=/var/lib/yourbarmate-suppliers
SCRAPER_STATE_ROOT=/var/lib/yourbarmate-suppliers/state
SCRAPER_LOG_ROOT=/var/log/yourbarmate-suppliers
SCRAPER_CACHE_ROOT=/var/lib/yourbarmate-suppliers/cache

# Playwright browser cache
PLAYWRIGHT_BROWSERS_PATH=/var/lib/yourbarmate-suppliers/playwright-browsers
